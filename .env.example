# Copy to .env and adjust. Every variable is optional; defaults are shown.
#
# Which LLM backend the analyzer uses for bulk triage (validators, scoring).
#   ollama   -> local Ollama container (default, private, free)
#   llamacpp -> llama.cpp server running on the Docker HOST (default http://host.docker.internal:8080)
#   hosted   -> hosted OpenAI-compatible API (needs HOSTED_BASE_URL + HOSTED_API_KEY)
LLM_PROVIDER=ollama

# Optional override for the deep-analysis route (company intel).
# When unset, the deep route falls back to LLM_PROVIDER.
# Example: LLM_PROVIDER=ollama with LLM_DEEP_PROVIDER=hosted
#   -> cheap local triage, powerful hosted model for deep analysis.
LLM_DEEP_PROVIDER=

# Model name sent to the backend. For Ollama this must be pulled first:
#   docker compose exec llm ollama pull hermes3:8b
LLM_MODEL=hermes3:8b

# Optional different model for the deep-analysis route. Falls back to LLM_MODEL.
LLM_DEEP_MODEL=

# HTTP timeout (seconds) for LLM requests.
LLM_TIMEOUT_SECONDS=120

# Base URL of the Ollama server (the `llm` service in compose).
OLLAMA_BASE_URL=http://llm:11434

# Base URL of a llama.cpp server on the Docker host.
# Start it on the host, e.g.: llama-server -m /path/to/model.gguf --port 8080
LLAMACPP_BASE_URL=http://host.docker.internal:8080

# Hosted OpenAI-compatible endpoint + key. Only used when a route selects `hosted`.
# Example (Meta Muse Spark API): HOSTED_BASE_URL=https://api.meta.ai/v1  (check current docs)
HOSTED_BASE_URL=
HOSTED_API_KEY=

# Sentence-transformers embedding model id (short BAAI names get the BAAI/ prefix).
EMBEDDING_MODEL=bge-small-en-v1.5

# --- Ingestion sources (api service) ---
# Five sources: Hacker News, Adzuna, RemoteOK, Arbeitnow, The Muse.
# Only Adzuna needs credentials. Everything below is a
# FALLBACK DEFAULT: once you save settings in the dashboard's Search
# the web panel, the values stored in the local DB win over these, and
# a Run search request's own values win over both. Saving in the panel
# never modifies this file.
# The api reaches the analyzer over the compose network; override only for
# local (non-Docker) api development.
# ANALYZER_BASE_URL=http://localhost:8000

# Adzuna credentials (free at developer.adzuna.com). When unset everywhere
# (env and panel), the Adzuna source is skipped; the five keyless sources
# still ingest.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# Adzuna search tuning (country code, keywords, location, pages per run).
ADZUNA_COUNTRY=us
# ADZUNA_WHAT=software engineer
# ADZUNA_WHERE=remote
ADZUNA_MAX_PAGES=2

# --- Discord bot (optional, Phase 10) ---
# A /jobradar slash command on your own Discord server, backed by the same
# local API. Leave the token empty and the bot service simply idles; the
# dashboard works exactly as before. Setup steps are in the README's
# "Discord bot" section. The token is used only by the bot service to log
# in to Discord — it is never sent to the API or shown anywhere.
# DISCORD_BOT_TOKEN=
# Your server's id (Discord Developer Mode → right-click the server →
# Copy Server ID). Registering per-server makes /jobradar appear instantly.
# DISCORD_GUILD_ID=
# Optional: when set, only members holding this role can use /jobradar.
# When empty, the whole server can.
# DISCORD_ALLOWED_ROLE_ID=
